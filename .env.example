# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is git-ignored, so the real credentials stay on your machine. The API
# reads the matching connection string from User Secrets, not from this file
# (see README.md).
POSTGRES_DB=medgid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Host port Postgres is published on. Change it if 5432 is free on your machine.
POSTGRES_PORT=5433
